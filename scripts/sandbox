#!/usr/bin/env bash
# A throwaway pm environment: its own HOME (registry, config dir, global
# assets, gitconfig), a private tmux server, and the built `pm` plus harness
# shims first on PATH. Nothing in it touches the real ~/ or the default tmux
# server. Naming follows the lib tests (server `pm-test-<name>`, HOME
# `$TMPDIR/pm-test-home-<name>`) so the recovery command in AGENTS.md covers
# a sandbox too, and `cargo test` reaps one whose name is a dead pid.
set -eu

usage() {
  cat <<'USAGE'
Usage: scripts/sandbox [COMMAND] [OPTIONS] [-- CMD...]

  (none)                        up if needed, shell, then down on exit
  up [--real] [--pm P] [--shell S]  create the sandbox (builds pm unless --pm);
                                replaces one an interrupted up/down left
  run [-C DIR] -- CMD...        run CMD with the sandbox's environment
                                (cwd DIR, relative to the sandbox HOME)
  shell                         interactive shell inside the sandbox
  attach [SESSION]              attach to the sandbox's tmux server
  status                        sessions, windows, recorded harness invocations
  path                          print the sandbox HOME
  trust DIR...                  (--real) mark DIRs trusted for claude, so an
                                agent spawned there skips the trust prompt;
                                run it before `pm feat new`/`pm agent spawn`
                                (relative to the sandbox HOME, exact paths —
                                claude does not inherit trust from parents)
  down [--force]                stop the server and every process still
                                in the sandbox env, then delete the HOME;
                                a running test binary's pid-named sandbox
                                only with --force
  list                          every sandbox on this machine: windows (each
                                holds a pty), age, creator, and why it is
                                stale if it is
  prune [--all]                 down every stale sandbox (see list); --all
                                downs every sandbox. Never touches a running
                                test binary's pid-named one

  -n NAME    sandbox name (default: "default", or $PM_SANDBOX)
  --real     real claude/codex/opencode instead of shims, with
             ~/.claude.json and ~/.codex/auth.json copied in. Claude Code
             credentials are not copied: the sandbox inherits
             CLAUDE_CODE_OAUTH_TOKEN or ANTHROPIC_API_KEY from the caller;
             when neither is set, the token (from `claude setup-token`) is
             read from $PM_SANDBOX_CLAUDE_TOKEN_FILE (default
             ~/.config/pm-secrets/claude-token) into the environment of
             `up`, `run` and `shell` — never into a file. Failing both, log
             in once (attach, then /login). `trust` each project dir before
             spawning agents in it. opencode gets nothing copied: set its
             providers in pm config ([harness.opencode.providers.<id>])
  --shell S  shell tmux windows run (default: $SHELL, non-login, no rc files
             since HOME is the sandbox)

Inside the sandbox, `pm` is the built binary and `claude`/`codex`/`opencode`
are shims that record their invocation under $HOME/log and hold the window
open; so are `launchctl` (always: launchd's domain is the user's) and
`tailscale` (not connected). `run` and `shell` unset TMUX (the caller's
names the real server); windows on the sandbox server get their own TMUX
from tmux, as in production.
Example:
  scripts/sandbox up
  scripts/sandbox run -- pm init proj
  scripts/sandbox run -C proj/main -- pm feat new login --context 'Do X'
  scripts/sandbox status
  scripts/sandbox down
USAGE
}

die() { echo "sandbox: $*" >&2; exit 1; }

here=$(cd "$(dirname "$0")/.." && pwd -P)
name=${PM_SANDBOX:-default}
real=0 all=0 force=0 pm_bin="" shell_bin="" cdir="" cmd="" session=""
dirs=()
while [ $# -gt 0 ]; do
  case $1 in
    -n) name=$2; shift 2 ;;
    --real) real=1; shift ;;
    --all) all=1; shift ;;
    --force) force=1; shift ;;
    --pm) pm_bin=$2; shift 2 ;;
    --shell) shell_bin=$2; shift 2 ;;
    -C) cdir=$2; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    --) shift; break ;;
    -*) usage >&2; die "unknown option: $1" ;;
    *) if [ -z "$cmd" ]; then cmd=$1
       elif [ "$cmd" = attach ] && [ -z "$session" ]; then session=$1
       elif [ "$cmd" = trust ]; then dirs+=("$1")
       else usage >&2; die "unexpected argument: $1 (put a command after --)"
       fi
       shift ;;
  esac
done
case $name in
  *[!A-Za-z0-9_-]*|"") die "invalid sandbox name '$name' (use [A-Za-z0-9_-])" ;;
esac

tmpbase=$(cd "${TMPDIR:-/tmp}" && pwd -P)
sockdir="${TMUX_TMPDIR:-/tmp}/tmux-$(id -u)"
caller_path=$PATH caller_agent=${PM_AGENT_NAME:-}

# A real sandbox's Claude Code token: exported (so it reaches the tmux
# server and every process through the environment, not argv) when the
# caller has no Claude credential of its own.
load_claude_token() {
  local f=${PM_SANDBOX_CLAUDE_TOKEN_FILE:-$HOME/.config/pm-secrets/claude-token}
  [ -z "${CLAUDE_CODE_OAUTH_TOKEN:-}" ] && [ -z "${ANTHROPIC_API_KEY:-}" ] || return 0
  if [ ! -r "$f" ]; then
    echo "sandbox: no CLAUDE_CODE_OAUTH_TOKEN and no token file at $f; claude will ask to /login" >&2
    return 0
  fi
  CLAUDE_CODE_OAUTH_TOKEN=$(tr -d '[:space:]' < "$f")
  export CLAUDE_CODE_OAUTH_TOKEN
}

# Point every helper at sandbox NAME. The sandbox environment: everything
# the real machine could leak through is unset, and the sandbox's own bin/
# leads PATH.
select_sandbox() {
  name=$1
  home="$tmpbase/pm-test-home-$name"
  server="pm-test-$name"
  socket="$sockdir/$server"
  sandbox_env=(-u TMUX -u XDG_CONFIG_HOME -u XDG_DATA_HOME -u XDG_STATE_HOME
    -u XDG_CACHE_HOME -u CODEX_HOME -u PM_AGENT_NAME -u PM_OPENCODE_SESSION
    -u OPENCODE_CONFIG -u OPENCODE_CONFIG_CONTENT
    -u GIT_CONFIG_GLOBAL -u GIT_AUTHOR_NAME -u GIT_AUTHOR_EMAIL
    -u GIT_COMMITTER_NAME -u GIT_COMMITTER_EMAIL
    HOME="$home" PM_TMUX_SERVER="$server" PM_SANDBOX="$name"
    PATH="$home/bin:$caller_path")
}
select_sandbox "$name"
scrubbed() { env "${sandbox_env[@]}" "$@"; }
stmux() { scrubbed tmux -L "$server" "$@"; }
exists() { [ -d "$home" ]; }
# The pm `up` installed, recorded as its last step and removed as the first
# of `down`; empty if the sandbox is incomplete.
installed_pm() {
  local want
  want=$(meta "$name" pm)
  [ -n "$want" ] && [ -x "$home/bin/pm" ] && echo "$want"
}
# A HOME without its pm would leave the installed `pm` first on PATH, so
# the build under test would silently not be the one running.
require() {
  exists || die "no sandbox '$name' (scripts/sandbox up -n $name)"
  [ -n "$(installed_pm)" ] \
    || die "sandbox '$name' at $home is incomplete (an interrupted up or down), so its pm build may be missing: scripts/sandbox up -n $name replaces it"
}

up() {
  if exists; then
    [ -z "$(installed_pm)" ] || die "sandbox '$name' already exists at $home (down first)"
    echo "sandbox '$name' at $home is incomplete (an interrupted up or down); removing it"
    down
  fi
  if [ -z "$pm_bin" ]; then
    (cd "$here" && cargo build -q)
    pm_bin=$here/target/debug/pm
  fi
  [ -f "$pm_bin" ] || die "--pm $pm_bin: no such file"
  case $pm_bin in /*) ;; *) pm_bin=$(cd "$(dirname "$pm_bin")" && pwd)/$(basename "$pm_bin") ;; esac
  mkdir -p "$home/bin" "$home/log"
  # Who made it, for `list` and `prune`.
  printf 'created=%s\nworktree=%s\nagent=%s\n' "$(date +%s)" "$here" "$caller_agent" \
    > "$home/.sandbox"
  printf '[user]\n\tname = Sandbox\n\temail = sandbox@example.com\n[init]\n\tdefaultBranch = main\n' \
    > "$home/.gitconfig"
  ln -s "$pm_bin" "$home/bin/pm"
  if [ "$real" = 1 ]; then
    echo "real=1" >> "$home/.sandbox"
    load_claude_token
    [ -f "$HOME/.claude.json" ] && cp "$HOME/.claude.json" "$home/.claude.json"
    if [ -f "$HOME/.codex/auth.json" ]; then
      mkdir -p "$home/.codex" && cp "$HOME/.codex/auth.json" "$home/.codex/auth.json"
    fi
  else
    for h in claude codex opencode; do
      cp "$here/scripts/harness-shim.sh" "$home/bin/$h"
      chmod +x "$home/bin/$h"
    done
  fi
  # launchd's gui/<uid> domain is the user's, not the sandbox's: a real
  # `launchctl` would boot out the user's own `pm serve`. The shim records each
  # call and keeps which labels are loaded; `tailscale` reads as installed
  # but not connected, so nothing changes the user's tailnet.
  cat > "$home/bin/launchctl" <<'SHIM'
#!/bin/sh
echo "$*" >> "$HOME/log/launchctl.argv"
loaded="$HOME/log/launchctl.loaded"
touch "$loaded"
case $1 in
  print) grep -qxF "${2##*/}" "$loaded" ;;
  bootstrap) basename "$3" .plist >> "$loaded" ;;
  bootout) grep -vxF "${2##*/}" "$loaded" > "$loaded.tmp"; mv "$loaded.tmp" "$loaded" ;;
esac
SHIM
  cat > "$home/bin/tailscale" <<'SHIM'
#!/bin/sh
echo "$*" >> "$HOME/log/tailscale.argv"
echo "tailscale (sandbox shim): not connected" >&2
exit 1
SHIM
  chmod +x "$home/bin/launchctl" "$home/bin/tailscale"
  # A stale socket under this name (pid reuse) would point tmux at a dead
  # server.
  stmux kill-server 2>/dev/null || true
  rm -f "$socket"
  # The server is created in the sandbox env because every pane inherits
  # the server's environment, not the client's.
  stmux new-session -d -s keepalive -c /tmp
  # Windows would otherwise run a login shell, whose profile (macOS
  # path_helper) moves system dirs ahead of the sandbox's bin/.
  stmux set -g default-command "${shell_bin:-${SHELL:-/bin/sh}}"
  echo "pm=$pm_bin" >> "$home/.sandbox"
  echo "sandbox '$name' up: HOME=$home  tmux -L $server"
  local own=()
  for n in $(sandbox_names); do
    [ "$n" != "$name" ] && [ "$(meta "$n" worktree)" = "$here" ] && own+=("$n")
  done
  [ ${#own[@]} -eq 0 ] || echo "note: also up from this worktree: ${own[*]} (scripts/sandbox list)"
}

run() {
  require
  [ "$(meta "$name" real)" != 1 ] || load_claude_token
  [ $# -gt 0 ] || die "run: no command after --"
  case $cdir in
    "") cd "$home" ;;
    /*) cd "$cdir" ;;
    *) cd "$home/$cdir" ;;
  esac
  exec env "${sandbox_env[@]}" "$@"
}

shell() {
  require
  [ "$(meta "$name" real)" != 1 ] || load_claude_token
  cd "$home"
  echo "sandbox '$name': HOME=$home, tmux -L $server; exit to leave"
  scrubbed "${SHELL:-/bin/sh}" || true
}

attach() {
  require
  if [ -n "$session" ]; then exec stmux attach -t "$session"; else exec stmux attach; fi
}

status() {
  require
  echo "HOME=$home  server=$server"
  stmux list-windows -a -F '#{session_name}:#{window_index} #{window_name}' 2>/dev/null \
    || echo "(server not running)"
  for f in "$home"/log/*.argv "$home"/log/*.api; do
    [ -f "$f" ] || continue
    echo "--- ${f##*/}"
    sed 's/^/  /' "$f"
  done
}

trust() {
  require
  [ $# -gt 0 ] || die "trust: no directory given"
  [ -f "$home/.claude.json" ] || echo '{}' > "$home/.claude.json"
  for d in "$@"; do
    case $d in /*) ;; *) d="$home/$d" ;; esac
    node -e '
      const fs = require("fs");
      const [file, dir] = process.argv.slice(1);
      const j = JSON.parse(fs.readFileSync(file, "utf8"));
      j.projects = j.projects || {};
      j.projects[dir] = { ...(j.projects[dir] || {}), hasTrustDialogAccepted: true };
      fs.writeFileSync(file, JSON.stringify(j, null, 2));
    ' "$home/.claude.json" "$d"
    echo "trusted $d"
  done
}

# The server is killed even when the HOME is already gone (macOS prunes
# idle $TMPDIR entries), so a sandbox can never leak its server. Killing it
# is not enough: a job it started (`pm tmux watch`, a hook) can outlive it
# and write into the HOME while it is removed, so every sandbox process is
# stopped first.
down() {
  local had_socket=0 tree
  if [ "$force" = 0 ] && live_pid "$name"; then
    die "sandbox '$name' belongs to running process $name (--force to down it anyway)"
  fi
  [ -e "$socket" ] && had_socket=1
  if [ -f "$home/.sandbox" ]; then
    grep -v '^pm=' "$home/.sandbox" > "$home/.sandbox.tmp" || true
    mv "$home/.sandbox.tmp" "$home/.sandbox"
  fi
  # Read before the kill, which orphans the server's children to init.
  tree=$(server_tree)
  stmux kill-server 2>/dev/null || true
  rm -f "$socket"
  # shellcheck disable=SC2046,SC2086
  stop_pids $tree $(env_pids)
  if exists; then
    if ! remove_home; then
      # shellcheck disable=SC2046
      stop_pids $(env_pids)
      remove_home || {
        lsof +D "$home" 2>/dev/null >&2 || true
        die "could not remove $home: something still writes into it (above, if lsof found it); stop it and run down again"
      }
    fi
    echo "sandbox '$name' down"
  elif [ "$had_socket" = 1 ]; then
    echo "sandbox '$name' down (server only, no HOME)"
  else
    echo "no sandbox '$name'"
  fi
}

remove_home() { rm -rf "$home" 2>/dev/null; ! exists; }

# The sandbox server and its descendants.
server_tree() {
  local root
  root=$(stmux display -p '#{pid}' 2>/dev/null) || return 0
  ps -ax -o pid= -o ppid= | awk -v root="$root" '
    { parent[$1] = $2 }
    END {
      for (p in parent) {
        for (q = p; q != "" && q > 1; q = parent[q]) if (q == root) { print p; break }
      }
    }'
}

# Processes whose environment is the sandbox's, including any a dead
# server orphaned. macOS hides the environment of its own platform
# binaries (sh, sleep), which server_tree covers while the server lives.
env_pids() {
  local f p
  if [ -r /proc/self/environ ]; then
    for f in /proc/[0-9]*/environ; do
      tr '\0' '\n' < "$f" 2>/dev/null \
        | grep -qxF -e "HOME=$home" -e "PM_TMUX_SERVER=$server" || continue
      p=${f#/proc/}; echo "${p%/environ}"
    done
  else
    ps -Eww -ax -o pid= -o command= 2>/dev/null \
      | awk -v h=" HOME=$home " -v s=" PM_TMUX_SERVER=$server " \
          'index($0 " ", h) || index($0 " ", s) { print $1 }'
  fi
}

# TERM the given pids, except this script and its ancestors (a down run
# from a sandbox shell), then KILL whatever is left, and wait for them all.
stop_pids() {
  local p q self=" " left alive i
  for (( q = $$; q > 1; q = $(ps -o ppid= -p "$q" 2>/dev/null || echo 1) )); do
    self+="$q "
  done
  left=()
  for p in "$@"; do
    case $self in *" $p "*) continue ;; esac
    left+=("$p")
  done
  [ ${#left[@]} -gt 0 ] || return 0
  kill -TERM "${left[@]}" 2>/dev/null || true
  for i in $(seq 50); do
    [ "$i" != 30 ] || kill -KILL "${left[@]}" 2>/dev/null || true
    alive=()
    for p in "${left[@]}"; do kill -0 "$p" 2>/dev/null && alive+=("$p"); done
    [ ${#alive[@]} -gt 0 ] || return 0
    left=("${alive[@]}")
    sleep 0.1
  done
}

# Whether NAME is the pid of a live process: its sandbox belongs to a
# running test binary or smoke run.
live_pid() {
  case $1 in *[!0-9]*) return 1 ;; esac
  kill -0 "$1" 2>/dev/null
}

# Every sandbox name with a HOME or a socket, except a live pid's.
sandbox_names() {
  local p n
  for p in "$tmpbase"/pm-test-home-* "$sockdir"/pm-test-*; do
    [ -e "$p" ] || continue
    case $p in
      "$tmpbase"/pm-test-home-*) n=${p#"$tmpbase"/pm-test-home-} ;;
      *) n=${p#"$sockdir"/pm-test-} ;;
    esac
    case $n in *[!A-Za-z0-9_-]*|"") continue ;; esac
    live_pid "$n" && continue
    echo "$n"
  done | sort -u
}

# Field KEY of sandbox NAME's creation record, empty when absent.
meta() {
  sed -n "s/^$2=//p" "$tmpbase/pm-test-home-$1/.sandbox" 2>/dev/null || true
}

# Why sandbox NAME is stale, or nothing if it is not.
stale_reason() {
  local wt
  case $1 in *[!0-9]*) ;; *) echo "test run $1 exited"; return ;; esac
  [ -d "$tmpbase/pm-test-home-$1" ] || { echo "no HOME"; return; }
  tmux -L "pm-test-$1" has-session 2>/dev/null || { echo "server not running"; return; }
  wt=$(meta "$1" worktree)
  [ -z "$wt" ] || [ -d "$wt" ] || echo "worktree $wt gone"
}

list() {
  local n windows created age reason now
  now=$(date +%s)
  printf '%-20s %7s %6s  %-40s %s\n' NAME WINDOWS AGE CREATOR STALE
  for n in $(sandbox_names); do
    windows=$(tmux -L "pm-test-$n" list-windows -a 2>/dev/null | wc -l | tr -d ' ')
    created=$(meta "$n" created)
    if [ -n "$created" ]; then age="$(( (now - created) / 3600 ))h"; else age="?"; fi
    reason=$(stale_reason "$n")
    printf '%-20s %7s %6s  %-40s %s\n' "$n" "$windows" "$age" \
      "$(meta "$n" agent)@$(meta "$n" worktree)" "${reason:--}"
  done
}

prune() {
  local n pruned=0
  for n in $(sandbox_names); do
    if [ "$all" = 1 ] || [ -n "$(stale_reason "$n")" ]; then
      select_sandbox "$n"
      down
      pruned=$((pruned + 1))
    fi
  done
  [ "$pruned" -gt 0 ] || echo "nothing to prune"
}

case $cmd in
  "") created=0
      if [ -z "$(installed_pm)" ]; then up; created=1; fi
      shell
      if [ "$created" = 1 ]; then force=1 down; fi ;;
  up) up ;;
  run) run "$@" ;;
  shell) shell ;;
  attach) attach ;;
  status) status ;;
  path) echo "$home" ;;
  trust) trust ${dirs[@]+"${dirs[@]}"} ;;
  down) down ;;
  list) list ;;
  prune) prune ;;
  *) usage >&2; die "unknown command: $cmd" ;;
esac
